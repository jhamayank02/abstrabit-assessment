# Server port
PORT=3000

# Required for the OpenAI Agents SDK chat/tool-calling loop.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Local SQLite database path. This is the default free local setup.
DATABASE_PATH=assistant.db

# Optional hosted PostgreSQL connection string for deployments that provide one.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assistant
